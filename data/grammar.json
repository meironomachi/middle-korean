{
  "meta": {
    "title": "중세 한국어 문법 — 조사와 어미",
    "scope": "후기 중세국어(15~16세기) 중심. 훈민정음 창제 이후 한글 문헌에 나타나는 형태를 기준으로 함",
    "note": "rule 은 기계가 판정할 수 있게 적은 조건이고, env 는 같은 내용을 사람이 읽는 말로 적은 것임. 둘은 같은 조건을 가리킴",
    "rule_keys": {
      "ends": "앞 체언·어간의 끝. consonant=자음(받침), vowel=모음, vowel_i=ㅣ 모음, vowel_not_i=ㅣ 이외의 모음, l=ㄹ 받침",
      "harmony": "앞 음절 모음의 모음조화 부류. yang=양성(ㅏ ㅗ ㆍ), yin=음성(ㅓ ㅜ ㅡ), neutral=중성(ㅣ)",
      "animacy": "animate=유정명사(사람·짐승), inanimate=무정명사",
      "honorific": "true=높임의 대상"
    },
    "sources": [
      "한국어 위키백과 「중세 한국어」 (CC BY-SA 4.0) — 조사 표와 예문",
      "표준적인 중세국어 문법 기술 — 어미 체계"
    ]
  },
  "particles": [
    {
      "id": "nominative",
      "name": "주격 조사",
      "modern": "이/가",
      "note": "현대어의 '가'는 중세국어에 없었음. 16세기 후반에야 나타남",
      "forms": [
        {
          "form": "이",
          "env": "자음으로 끝나는 체언 뒤",
          "rule": {
            "ends": "consonant"
          },
          "examples": [
            {
              "mk": "어린 百姓이",
              "ko": "어리석은 백성이",
              "src": "훈민정음 언해"
            }
          ]
        },
        {
          "form": "ㅣ",
          "env": "ㅣ 이외의 모음으로 끝난 체언 뒤 (앞 글자에 붙여 적음)",
          "rule": {
            "ends": "vowel_not_i"
          },
          "examples": [
            {
              "mk": "부톄 마조 나아 마ᄌᆞ샤",
              "ko": "부처가 마주 나와 맞으시어",
              "note": "부터 + ㅣ → 부톄"
            },
            {
              "mk": "孔子ㅣ ᄆᆞᅀᆞᆯᄒᆡ 겨셔",
              "ko": "공자가 마을에 계셔"
            }
          ]
        },
        {
          "form": "∅",
          "env": "ㅣ 모음으로 끝난 체언 뒤 — 아무것도 붙지 않음",
          "rule": {
            "ends": "vowel_i"
          },
          "examples": [
            {
              "mk": "불휘 기픈 남ᄀᆞᆫ",
              "ko": "뿌리 깊은 나무는",
              "src": "용비어천가 제2장"
            }
          ]
        }
      ]
    },
    {
